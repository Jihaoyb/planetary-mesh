# Copy to config/coordinator.env for local runs.
COORDINATOR_ADDR=:8080

# Leave empty or commented for in-memory storage.
# COORDINATOR_DATABASE_URL=postgres://planetary:planetary@localhost:5432/planetary_mesh?sslmode=disable

# mTLS remains optional for local development.
# COORDINATOR_TLS_CA_FILE=./certs/ca.pem
# COORDINATOR_TLS_CERT_FILE=./certs/coordinator.pem
# COORDINATOR_TLS_KEY_FILE=./certs/coordinator-key.pem
# COORDINATOR_ALLOWED_NODE_IDENTITIES=local-agent-1=dns:agent-1.local,local-agent-2=dns:agent-2.local
